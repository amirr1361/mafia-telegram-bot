BOT_TOKEN=your_telegram_bot_token_here
# Optional: SQLite path for ratings & medals archive (default: ./data/mafia_bot.sqlite3)
# DATABASE_PATH=/path/to/mafia_bot.sqlite3

# Game audit log (JSONL per match, for troubleshooting)
# GAME_AUDIT_LOG_ENABLED=1
# GAME_AUDIT_LOG_DIR=./data/game_logs

# Emergency (private chat): send MAFIA_PANIC_TRIGGER, then MAFIA_PANIC_PASSWORD — closes all in-memory rooms and restarts the Python process (use systemd/docker --restart).
# MAFIA_PANIC_TRIGGER=ریست ربات
# MAFIA_PANIC_PASSWORD=1234
# Strongly recommended: comma-separated Telegram user IDs allowed to use this flow
# MAFIA_PANIC_OWNER_IDS=
